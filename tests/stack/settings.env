# The settings file of the stack test (tests/stack/run.sh), in the place of the person's .env.
# Every outside service is a stand-in (tests/stack/standins.py, reached as `standins` by the core),
# every key is one only those stand-ins take, and nothing here is anybody's. run.sh adds the
# database password and the address the page is published on.

ROUH_STACK_NAME=rouh-stack-test
ROUH_PORT=8420
ROUH_PUBLIC_URL=http://127.0.0.1:8420
ROUH_DEFAULT_ZONE=Europe/Athens
ROUH_MAIL_FROM=noreply@example.com
ROUH_OWN_MAILBOXES=rouh@example.com
ROUH_VOICE_REPLIES=0
ROUH_RELAY=0
ROUH_INSTALL_CODE=
ONE_MAX_RUNS=2
# A run may hold 256 MB here, so a run that holds more is ended in the test (one.run-memory).
ONE_RUN_MEMORY_MAX=256M

# The models: Anthropic's and OpenAI's stand-ins, for the core directly and, through the key
# proxy (compose.test.yml), for the workers.
ANTHROPIC_API_KEY=sk-ant-stack-test-not-a-real-one
ANTHROPIC_BASE_URL=http://standins:9001
OPENAI_API_KEY=sk-test-key-not-a-real-one
OPENAI_BASE_URL=http://standins:9002/v1
ROUH_GOOGLE_BASE_URL=http://standins:9003/v1beta/openai/
ROUH_XAI_BASE_URL=http://standins:9003/v1

# The voice.
ELEVENLABS_API_KEY=test-key-not-a-real-one
ELEVENLABS_BASE_URL=http://standins:9013/v1
ROUH_REALTIME_STT=0

# Everyone else Rouh talks to.
ROUH_CARDDAV_URL=http://standins:9004/
ROUH_BREVO_URL=http://standins:9005
ROUH_BREVO_API_KEY=xkeysib-test-not-a-real-one
ROUH_APIFY_URL=http://standins:9006
APIFY_API_TOKEN=apify_api_test0not0a0real0one
VOYAGE_ENDPOINT=http://standins:9007
VOYAGE_API_KEY=voyage-test-key-not-a-real-one
ROUH_STRIPE_API_BASE=http://standins:9008
ROUH_CLOUDFLARE_API=http://standins:9009
ROUH_SLACK_API=http://standins:9010/api
ROUH_HUE_API=http://standins:9011
ROUH_HUE_SIGN_IN=http://127.0.0.1:19011
ROUH_DREAME_API=http://standins:9012
ROUH_TELEGRAM_API_BASE=http://standins:9014
ROUH_TELEGRAM_BOT_TOKEN=123456789:stack-test-not-a-real-one
ROUH_TELEGRAM_CHAT_ID=4242
ROUH_TELEGRAM_ACCOUNT_URL=http://standins:9014/account
ROUH_GOOGLE_AUTH_URL=http://127.0.0.1:19015/o/oauth2/v2/auth
ROUH_GOOGLE_TOKEN_URL=http://standins:9015/token
ROUH_GOOGLE_REVOKE_URL=http://standins:9015/revoke
ROUH_GOOGLE_USERINFO_URL=http://standins:9015/userinfo
ROUH_GOOGLE_API_BASE=http://standins:9015
ROUH_GOOGLE_RATE_LIMIT=200
MEETING_LIBRARY_URL=http://standins:9016
MEETING_LIBRARY_KEY=ml_test-key-not-a-real-one
MEETING_LIBRARY_WEBHOOK_SECRET=stack-test-meeting-hook-secret
ROUH_YOUTUBE_API=http://standins:9018
YOUTUBE_API_KEY=AIza-test-key-not-a-real-one

# rouh.land is never reached from the stack test.
ROUH_MODEL_STANDARD_URL=http://standins:1/no-rouh-it/standard.json
ROUH_MODEL_OUTCOMES_URL=http://standins:1/no-rouh-it/outcomes
ROUH_MODEL_OUTCOMES_SEND=0
ROUH_BIRTH_URL=http://standins:1/no-rouh-it

# Nor the map services a location's clock and place are looked up with (page.location).
ROUH_LOCATION_ZONE_URL=http://standins:1/no-map
ROUH_LOCATION_PLACE_URL=http://standins:1/no-map
ROUH_LOCATION_SEARCH_URL=http://standins:1/no-map

# The owner's one server a run may reach over ssh: the stand-in's echo on 2222 (runs.ssh); and
# the stand-in website the browser opens (browser.live), on the same private network.
ROUH_KEYPROXY_ALLOW=standins:2222,shop.stack.test:9017,standins:9418

# This stack is a Creator Rouh (task 161): its protected core pushes a checked change, and the
# nightly base level, to "rouh-core" - a git server among the stand-ins, seeded with the code
# under test - through the key proxy (creator.push-main, creator.merge-runs, nightly.base-patch).
ROUH_GUARD_UPSTREAM=git://standins/rouh-core.git
ROUH_GUARD_UPSTREAM_SETTLE=20
ROUH_GUARD_UPSTREAM_EVERY=10

# The owner's own repository for the workspace: a git server among the stand-ins (workspace.github).
ROUH_WORKSPACE_REMOTE=git://standins/workspace.git

# The machine's UPS: NUT's upsd among the stand-ins, on battery (machine.ups).
ROUH_UPS=ups@standins:3493

# The weekly copy off the machine, to the stand-in for R2 (backup.offsite); run.sh adds the age
# public key it is encrypted for, ROUH_OFFSITE_RECIPIENT.
ROUH_OFFSITE_ENDPOINT=http://standins:9019
ROUH_OFFSITE_BUCKET=stack-test-backups
ROUH_OFFSITE_KEY_ID=stack-test-key-id
ROUH_OFFSITE_SECRET=stack-test-secret-not-a-real-one

# Rouh's updates (rouh/code_update.py, tests/stack/checks_updates.py): rouh.land's release and GitHub's
# tarballs are the stand-ins' port 9021, which the check fills; the ride along looks every 20 seconds.
ROUH_CODE_RELEASE_URL=http://standins:9021/mac/code/release.json
ROUH_CODE_TARBALL=http://standins:9021/tarball/{commit}
ROUH_CODE_UPDATE_EVERY=20
ROUH_CODE_UPDATE_FRESH=15
