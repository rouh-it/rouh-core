#!/usr/bin/env python3
"""rouh-catch-up: once, bring a Rouh whose code is older than Rouh's updates up to the newest release.

Task 187, 16 November 2026. A Rouh installed before 11 November 2026 (task 140, step 140-18) has no
"Update to the newest Rouh" on Meta, Changes and never rides along, because the code that does it is
not in its code, and a base update never changes /code. Its built-in source names the organisation by
its name before 16 November 2026, which is now rouh-land. This does, once, what an update of 140-18 does,
from outside that code: in the Rouh's protected core, which has /code, the internet through the key
proxy, and the change step with its undo points.

    docker exec -i rouh-guard-1 python3 -I - < rouh-catch-up        (bin/rouh-catch-up-mac does it)

  1. Refuses, changing nothing, unless /code is a clean git repository whose code has no
     rouh/code_update.py (a Rouh that has it updates itself from Meta, Changes) and that says which
     release it came from: its first install (.git/rouh-installed.json and one first commit, as
     rouh-code-install writes them) or an earlier update (a Rouh-release: line).
  2. The newest release, as rouh.land's /mac/code/release.json names it; its tarball from the public
     rouh-core on GitHub (rouh-land), which must say it is that very commit.
  3. In a clone, the release's files are committed on top of the release this Rouh came from, with a
     Rouh-release: line (so from then on its own updates know where it stands), and this Rouh's own
     commits are merged on top; a file where its own change and the release changed the same lines
     is kept as this Rouh had it, and named (140-18's rule).
  4. The merge is fetched into /code under refs/rouh/update/<time> and handed to the protected core
     (rouh-guard propose): its frozen security checks and the new code's own checks, then an undo
     point, main moved, and the core and the worker started again on it. Refused: nothing runs.

It never touches the database, the keys, the settings or anything outside /code's refs; the core's
start migrates the database as on every update. Take a copy of the database first (rouh-backup now in
the backup part; bin/rouh-catch-up-mac does). Undo: Meta, Changes, Put back on the point before, or
rouh-guard undo N; then, if the database must go back too, rouh-backup restore <the copy>.

    --check   say what it would do, and change nothing
    --fresh   a Rouh whose code should simply be the newest release, as a fresh install has it: the
              same as --stuck, but nothing of its own code is carried over. Its account, sign-in,
              connections and settings (the database), keys, rouh.page name (/data/rouh/relay) and
              workspace are kept; the database is migrated to the release when Rouh starts again.
    --stuck   a Rouh that has Rouh's updates, but whose update cannot move (19 November 2026: a Rouh
              said "0 copied exactly, 0 adapted, 74 waiting", every change behind one its model call
              could not adapt, and the fixes for that behind it too). The same, from the release its
              code was installed from (or brought by an earlier catch-up), with the changes its updates
              took and its own merged on top. Its update then counts every change up to the release
              as taken (rouh/code_evolution.py, caught_up), and goes on from there. A file it has as
              shared main once had it is not its own (earlier updates left such versions, some by
              commits with no Rouh-master-change: line): the release's version wins, conflict or not;
              shared main's history is fetched for this, its trees only (ROUH_CODE_MASTER). Its own
              commits are listed first. On 20 November 2026 a Mac kept five such files, urls.py among
              them, and the protected core refused the result: it did not import. A file where its own
              lines clash with the release's is never kept whole: the release's file, with only its own
              lines laid over it when they fit, else the release's alone; and when the protected core
              refuses that, the release with only its own new files is handed it as a second choice.
              Whatever of its own is left out is named, and stays in its history. The protected core's
              copies of an update step are released content, never counted as its own.
              An own new migration that would leave its app two last migrations beside the release's
              is left out before anything is proposed (nothing would migrate, and every check would
              fail on a missing table); if the core still refuses, the third choice is the release
              alone. Every failure the core gives is printed, the database's migration first.
Settings: ROUH_SITE_URL (https://rouh.land), ROUH_CODE_RELEASE_URL (its /mac/code/release.json),
ROUH_CODE_TARBALL ({org} and {commit} filled in), ROUH_APP_DIR (/code), ROUH_GUARD_BIN
(/opt/rouh-guard/bin).
"""
from __future__ import annotations

import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

CODE = Path(os.environ.get("ROUH_APP_DIR", "/code"))
SITE = (os.environ.get("ROUH_SITE_URL") or "https://rouh.land").strip().rstrip("/")
RELEASE_URL = os.environ.get("ROUH_CODE_RELEASE_URL") or f"{SITE}/mac/code/release.json"
TARBALL = os.environ.get("ROUH_CODE_TARBALL") or "https://codeload.github.com/rouh-land/rouh-core/tar.gz/{commit}"
#: Shared main, whose history (its trees only, never a file's contents) tells a version of a file main once
#: had from an edit of this Rouh's own (--stuck).
MAIN = os.environ.get("ROUH_CODE_MASTER") or "https://github.com/rouh-land/rouh-core.git"
GUARD = Path(os.environ.get("ROUH_GUARD_BIN", "/opt/rouh-guard/bin")) / "rouh-guard"
#: As rouh-code-install and rouh/code_update.py: release tools a Rouh never runs.
LEFT_OUT = ("guard", "mac", ".github", "deploy/container")
TRAILER = "Rouh-release"
MOST = 400 * 1024 * 1024
UA = "rouh-catch-up/1"
ROUH = ["setpriv", "--reuid=10001", "--regid=10001", "--init-groups", "--"]
SHA = re.compile(r"[0-9a-f]{40}")


class Refused(Exception):
    pass


def say(text: str) -> None:
    print(f"rouh-catch-up: {text}", flush=True)


def git(*args: str, cwd: Path, check: bool = False) -> subprocess.CompletedProcess:
    pre = ROUH if os.getuid() == 0 else []
    r = subprocess.run([*pre, "git", "-c", "safe.directory=*", "-c", "user.name=Rouh",
                        "-c", "user.email=rouh@localhost", *args],
                       cwd=cwd, capture_output=True, text=True, env={**os.environ, "HOME": "/tmp"})
    if check and r.returncode:
        raise Refused(f"git {args[0]} failed: {(r.stderr or r.stdout).strip()[-400:]}")
    return r


def out(*args: str, cwd: Path) -> str:
    return git(*args, cwd=cwd, check=True).stdout.strip()


def came_from(code: Path) -> dict:
    """As rouh/code_update.py's base(): {"release", "local"} of the release this code holds, or Refused."""
    log = git("log", "--format=%H%x1f%(trailers:key=" + TRAILER + ",valueonly,separator=)%x1e", "HEAD", cwd=code)
    for rec in log.stdout.split("\x1e"):
        sha, _, said = rec.strip().partition("\x1f")
        if sha and SHA.fullmatch(said.strip()):
            return {"release": said.strip(), "local": sha, "how": "an earlier update"}
    roots = git("rev-list", "--max-parents=0", "HEAD", cwd=code).stdout.split()
    if len(roots) != 1:
        raise Refused("its code is not one install with changes on top (it has "
                      f"{len(roots)} first commits), so it cannot say which release it came from.")
    try:
        installed = json.loads((code / ".git" / "rouh-installed.json").read_text())
    except (OSError, ValueError):
        installed = {}
    commit = str(installed.get("commit") or "")
    if not SHA.fullmatch(commit):
        # An install whose record is missing: its first commit says the commit in its words.
        m = re.search(r"Commit ([0-9a-f]{40}) of Rouh's main", out("log", "-1", "--format=%B", roots[0], cwd=code))
        commit = m.group(1) if m else ""
    if not SHA.fullmatch(commit):
        raise Refused("its code does not say which release it was installed from.")
    return {"release": commit, "local": roots[0], "how": "its first install"}


def fetch(url: str, most: int) -> bytes:
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "*/*"})
    with urllib.request.urlopen(req, timeout=300) as r:
        data = r.read(most + 1)
    if len(data) > most:
        raise Refused(f"{url.split('?')[0]} is larger than a release can be.")
    return data


def newest() -> dict:
    try:
        got = json.loads(fetch(RELEASE_URL, 512 * 1024))
    except urllib.error.HTTPError as e:
        raise Refused(f"rouh.land answered {e.code} for the newest release.") from None
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise Refused(f"rouh.land could not be reached ({getattr(e, 'reason', e)}).") from None
    if not isinstance(got, dict) or not SHA.fullmatch(str(got.get("commit") or "")):
        raise Refused("rouh.land's answer named no release.")
    return got


def download(commit: str) -> bytes:
    url = TARBALL.replace("{org}", "rouh-land").format(commit=commit)
    try:
        return fetch(url, MOST)
    except urllib.error.HTTPError as e:
        said = f"{url}: {e.code}"
    except (urllib.error.URLError, OSError) as e:
        said = f"{url}: {getattr(e, 'reason', e)}"
    raise Refused(f"the release could not be downloaded ({said}).")


def unpack(data: bytes, into: Path, commit: str) -> None:
    """GitHub's tarball of one commit, which must say it is that commit; nothing outside `into`."""
    try:
        tar = tarfile.open(fileobj=io.BytesIO(data), mode="r:*")
    except tarfile.TarError:
        raise Refused("the download is not a release of Rouh.") from None
    with tar:
        said = (tar.pax_headers or {}).get("comment", "")
        if said != commit:
            raise Refused(f"the download is not commit {commit[:12]} (it says {said[:12] or 'nothing'}).")
        members = []
        for m in tar.getmembers():
            parts = m.name.split("/", 1)
            if len(parts) < 2 or not parts[1]:
                continue
            rel = parts[1]
            if rel.startswith("/") or ".." in rel.split("/"):
                raise Refused(f"the download holds a path that climbs out ({rel[:80]}).")
            if m.issym() or m.islnk():
                target = os.path.normpath(os.path.join(os.path.dirname(rel), m.linkname))
                if m.linkname.startswith("/") or target.startswith(".."):
                    raise Refused(f"the download holds a link that points out ({rel[:80]}).")
            elif not (m.isfile() or m.isdir()):
                continue
            m.name = rel
            members.append(m)
        tar.extractall(into, members=members, filter="tar")


def guard(*args: str) -> dict:
    r = subprocess.run(["python3", "-I", str(GUARD), *args], capture_output=True, text=True, timeout=3900)
    try:
        return json.loads(r.stdout)
    except ValueError:
        raise Refused(f"the protected core did not answer ({(r.stderr or r.stdout).strip()[-300:]}).") from None


def day(iso: str) -> str:
    m = re.match(r"(\d{4})-(\d\d)-(\d\d)T", str(iso or ""))
    if not m:
        return "today"
    months = ["January", "February", "March", "April", "May", "June", "July", "August", "September",
              "October", "November", "December"]
    return f"{int(m.group(3))} {months[int(m.group(2)) - 1]} {m.group(1)}"


def released_versions(work: Path, local: str, head: str) -> tuple[set, dict]:
    """The files this Rouh's commits changed whose version at head is one shared main once had, and
    every version main had of each file they changed ({file: {blob, ...}})."""
    touched = [f for f in out("diff", "--name-only", "--no-renames", local, head, cwd=work).splitlines() if f]
    if not touched:
        return set(), {}
    r = git("fetch", "-q", "--filter=blob:none", "--no-tags", MAIN, "+refs/heads/main:refs/rouh/catch-up-main", cwd=work)
    if r.returncode:
        raise Refused("shared main's history could not be read, so its versions of this Rouh's files cannot be told "
                      "from its own edits: " + (r.stderr or r.stdout).strip()[-300:] + ". Nothing was changed.")
    seen: dict = {}
    for start in range(0, len(touched), 200):
        log_ = out("log", "--raw", "--no-abbrev", "--no-renames", "--format=", "refs/rouh/catch-up-main", "--",
                   *touched[start:start + 200], cwd=work)
        for line in log_.splitlines():
            meta, _, path = line.partition("\t")
            parts = meta.split()
            if len(parts) >= 4 and path:
                seen.setdefault(path, set()).update(x for x in parts[2:4] if set(x) != {"0"})
    found = set()
    for f in touched:
        got = git("rev-parse", "-q", "--verify", f"{head}:{f}", cwd=work)
        if got.returncode == 0 and got.stdout.strip() in seen.get(f, set()):
            found.add(f)
    return found, seen


MIGRATION_DEP = re.compile(r"""\(\s*["'](\w+)["']\s*,\s*["'](\w+)["']\s*\)""")


def migration_misfits(work: Path, release: str) -> list[str]:
    """This Rouh's own new migrations that would leave their app with two last migrations beside the
    release's: Django then refuses to migrate at all, and every check of the result fails on a table
    that is not there (20 November 2026: a Mac's own 0249 beside the release's 0265). Read from the
    files, nothing run."""
    added = [f for f in out("diff", "--cached", "--name-only", "--diff-filter=A", "--no-renames", release,
                            cwd=work).splitlines()
             if "/migrations/" in f and f.endswith(".py") and not f.endswith("__init__.py")]
    out_ = []
    for folder in sorted({str(Path(f).parent) for f in added}):
        names = {p.stem: p for p in (work / folder).glob("*.py") if p.stem != "__init__"}
        used = set()
        for p in names.values():
            used |= {m.group(2) for m in MIGRATION_DEP.finditer(p.read_text(errors="replace")) if m.group(2) in names}
        leaves = set(names) - used
        if len(leaves) > 1:
            out_ += [f for f in added if str(Path(f).parent) == folder]
    return sorted(out_)


def failures(answer: dict) -> list[str]:
    """Every failure the protected core gave, one line each, the database's migration first: when it
    fails, every check after it fails on a table that is not there, and only it says why."""
    got = [f"{f.get('name', 'a check')}: {f.get('why', '')}" for f in answer.get("failed") or []]
    got.sort(key=lambda l: 0 if "migrat" in l.lower() else 1)
    return got or [str(answer.get("refused") or answer.get("error") or "it did not say why")]


def blob_at(work: Path, rev: str, f: str) -> str:
    got = git("rev-parse", "-q", "--verify", f"{rev}:{f}", cwd=work)
    return got.stdout.strip() if got.returncode == 0 else ""


def own_lines_over(work: Path, f: str, local: str, head: str, release: str, seen: dict) -> bytes | None:
    """The release's version of f with this Rouh's own lines laid over it, or None when they do not fit.

    Its own lines are what its commits changed since the newest version of f shared main once had in
    its history (else since its install). A three-way merge of those lines onto the release's file:
    the release's whole file stays the ground, and only this Rouh's own hunks are carried."""
    base = ""
    for c in out("log", "--format=%H", f"{local}..{head}", "--", f, cwd=work).splitlines():
        if blob_at(work, c, f) in seen.get(f, set()):
            base = blob_at(work, c, f)
            break
    base = base or blob_at(work, local, f)
    if not base:
        base = subprocess.run(["git", "-c", "safe.directory=*", "hash-object", "-w", "--stdin"], cwd=str(work),
                              input=b"", capture_output=True).stdout.decode().strip()
    theirs, ours = blob_at(work, release, f), blob_at(work, head, f)
    if not theirs or not ours:
        return None
    r = subprocess.run(["git", "-c", "safe.directory=*", "merge-file", "--object-id", "-p", theirs, base, ours],
                       cwd=str(work), capture_output=True, timeout=120)
    return r.stdout if r.returncode == 0 else None


#: The subject the protected core's update step gives its copy of a release's update step
#: (guard/rouh_guard/updatestep.py): released content, never this Rouh's own.
UPDATE_STEP = re.compile(r"update step from the release [0-9a-f]{7,40}, copied exactly by the protected core", re.I)


def own_commits(local: str, head: str) -> list[str]:
    """This Rouh's commits since the release it came from that are not released changes its updates
    took (Rouh-master-change:), as "<sha> <subject>"; the protected core's copies of an update step
    marked as released."""
    lines = [l for l in out("log", "--no-merges", "--invert-grep", "--grep=^Rouh-master-change:", "--format=%h %s",
                            f"{local}..{head}", cwd=CODE).splitlines() if l]
    return [("released, not its own: " if UPDATE_STEP.search(l) else "") + l for l in lines]


def catch_up(dry: bool, stuck: bool = False, fresh: bool = False) -> int:
    if not (CODE / ".git").exists():
        raise Refused(f"{CODE} is not a Rouh's code (no git repository).")
    if git("cat-file", "-e", "HEAD:rouh/code_update.py", cwd=CODE).returncode == 0 and not stuck:
        raise Refused("this Rouh already has Rouh's updates: press Update to the newest Rouh in Anatomy, "
                      "Meta, Changes instead; if its update cannot move, run this with --stuck. Nothing was changed.")
    if out("status", "--porcelain", "--untracked-files=normal", cwd=CODE):
        raise Refused("its code has work in it that is not committed; nothing was changed.")
    b = came_from(CODE)
    head = out("rev-parse", "HEAD", cwd=CODE)
    # Its own changes: not the released changes its updates took (Rouh-master-change:), which the
    # release brings again anyway.
    own = sum(not l.startswith("released") for l in own_commits(b["local"], head))
    rel = newest()
    commit = rel["commit"]
    say(f"this Rouh came from Rouh {b['release'][:12]} ({b['how']}), with {own} change"
        f"{'' if own == 1 else 's'} of its own; the newest release is {commit[:12]} of {day(rel.get('released_at'))}.")
    for line in own_commits(b["local"], head)[:20]:
        say("  " + (line if line.startswith("released") else "its own: " + line))
    if commit == b["release"]:
        say("it already has that release; nothing to do.")
        return 0
    status = guard("status")
    point = ((status.get("code") or {}).get("point") or {})
    if point and point.get("commit") != head:
        raise Refused(f"the code that runs ({str(point.get('commit'))[:12]}) is not /code's main ({head[:12]}); "
                      "start Rouh again first. Nothing was changed.")
    if dry:
        say("--check: nothing was changed.")
        return 0

    say("downloading the release")
    data = download(commit)
    tmp = Path(tempfile.mkdtemp(prefix="rouh-catch-up-"))
    os.chown(tmp, 10001, 10001) if os.getuid() == 0 else None
    work = tmp / "work"
    try:
        git("clone", "-q", "--no-hardlinks", str(CODE), str(work), cwd=tmp, check=True)
        git("checkout", "-q", "-b", "rouh-release", b["local"], cwd=work, check=True)
        say("laying the release over the one this Rouh came from")
        for p in work.iterdir():
            if p.name != ".git":
                shutil.rmtree(p) if p.is_dir() and not p.is_symlink() else p.unlink()
        unpack(data, work, commit)
        if not (work / "manage.py").is_file() or not (work / "rouh").is_dir():
            raise Refused("the download holds no Rouh code.")
        evolution = work / "rouh" / "code_evolution.py"
        if stuck and "def caught_up(" not in (evolution.read_text(errors="replace") if evolution.is_file() else ""):
            raise Refused(f"the newest release ({commit[:12]}) cannot yet count a catch-up as taken, so its update "
                          "would go on trying the changes it already has. Wait for the next release of Rouh's code "
                          "and run this again. Nothing was changed.")
        for left in LEFT_OUT:
            if git("cat-file", "-e", f"{b['local']}:{left}", cwd=work).returncode == 0:
                continue
            p = work / left
            shutil.rmtree(p) if p.is_dir() else (p.unlink() if p.exists() else None)
        if os.getuid() == 0:
            subprocess.run(["chown", "-R", "10001:10001", str(work)], check=True)
        git("add", "-A", cwd=work, check=True)
        when = day(rel.get("released_at"))
        git("commit", "-q", "--allow-empty", "-m", f"Rouh {commit[:12]}, the release of {when}, as released",
            "-m", f"Commit {commit} of rouh-core's main, a release of Rouh's code (rouh.land, /mac/code/release.json), "
                  "exactly as a fresh install of it would have it, brought in once by rouh-catch-up because this "
                  "Rouh's code was older than Rouh's updates. This Rouh's own changes are merged on top of it.",
            "-m", f"{TRAILER}: {commit}", cwd=work, check=True)
        local_release = out("rev-parse", "HEAD", cwd=work)
        git("checkout", "-q", "-B", "catch-up", head, cwd=work, check=True)
        kept, carried, dropped, plain, left_out, misfit = [], [], [], "", [], []
        local_release_commit = ""
        if fresh:
            # --fresh: this Rouh's code becomes the release alone, as a fresh install has it; nothing of its
            # own code is carried (it stays in its history). Its database, keys, rouh.page name and workspace
            # are not code and are not touched here; Rouh's start migrates the database to the release.
            say("--fresh: the release alone, as a fresh install has it; this Rouh's own code changes are left out "
                "(they stay in its history), and its database, keys, rouh.page name and workspace are kept")
            merged = local_release
        elif head == b["local"]:
            merged = local_release
        else:
            say("keeping this Rouh's own changes")
            r = git("merge", "--no-ff", "--no-commit", "rouh-release", cwd=work)
            clashes = [f for f in out("diff", "--name-only", "--diff-filter=U", cwd=work).splitlines() if f]
            if r.returncode and not clashes:
                raise Refused("its own changes could not be laid over the release: " + (r.stderr or r.stdout).strip()[-300:])
            released, seen = released_versions(work, b["local"], head) if stuck else (set(), {})
            carried, dropped = [], []
            if stuck:
                # A file this Rouh has as shared main once had it is not its own: earlier updates took
                # changes out of order and left such versions; the release's version wins, conflict or
                # not. Only a version main never had is an edit of this Rouh's own (20 November 2026: a
                # Mac kept five such files, urls.py among them, and the result did not import).
                for f in sorted(released):
                    if git("cat-file", "-e", f"{local_release}:{f}", cwd=work).returncode == 0:
                        git("checkout", "-q", local_release, "--", f, cwd=work, check=True)
                        git("add", "--", f, cwd=work, check=True)
                    else:
                        git("rm", "-q", "--ignore-unmatch", "--", f, cwd=work, check=True)
                    if f in clashes:
                        clashes.remove(f)
                if released:
                    say(f"took the release's version of {len(released)} file{'' if len(released) == 1 else 's'} this Rouh "
                        "had as shared main once had it (left by earlier updates, not edits of its own): "
                        + ", ".join(sorted(released)[:12]) + (" and more" if len(released) > 12 else ""))
            for f in clashes:
                if stuck:
                    # Never the old whole file over the release's (20 November 2026: urls.py kept whole
                    # without the release's guest_state change, and nothing imported). The release's file,
                    # with this Rouh's own lines laid over it when they fit; else the release's alone.
                    laid = own_lines_over(work, f, b["local"], head, local_release, seen)
                    if laid is not None:
                        (work / f).write_bytes(laid)
                        git("add", "--", f, cwd=work, check=True)
                        carried.append(f)
                    elif git("cat-file", "-e", f"{local_release}:{f}", cwd=work).returncode == 0:
                        git("checkout", "-q", local_release, "--", f, cwd=work, check=True)
                        git("add", "--", f, cwd=work, check=True)
                        dropped.append(f)
                    else:
                        git("rm", "-q", "--ignore-unmatch", "--", f, cwd=work, check=True)
                        dropped.append(f)
                    continue
                if git("cat-file", "-e", f":2:{f}", cwd=work).returncode == 0:
                    git("checkout", "-q", "--ours", "--", f, cwd=work, check=True)
                    git("add", "--", f, cwd=work, check=True)
                else:
                    git("rm", "-q", "--", f, cwd=work, check=True)
                kept.append(f)
            msg = [f"Rouh {commit[:12]}, the release of {when}, with this Rouh's own changes kept",
                   f"The release's files merged with this Rouh's own {own} change{'s' if own != 1 else ''}, once, by rouh-catch-up."]
            if kept:
                msg.append("Kept as they were, because the release changed the same lines:\n" + "\n".join(f"- {f}" for f in kept))
            if carried:
                msg.append("The release's file with this Rouh's own lines laid over it:\n" + "\n".join(f"- {f}" for f in carried))
            if dropped:
                msg.append("The release's file, because this Rouh's own lines did not fit beside it (they are in its "
                           "history, before this commit):\n" + "\n".join(f"- {f}" for f in dropped))
            misfit = migration_misfits(work, local_release) if stuck else []
            if misfit:
                git("rm", "-q", "--", *misfit, cwd=work, check=True)
                msg.append("Its own migrations left out, because beside the release's they would give the app two last "
                           "migrations and nothing would migrate (they are in its history):\n" + "\n".join(f"- {f}" for f in misfit))
            git("commit", "-q", "--no-edit", "-m", msg[0], "-m", "\n\n".join(msg[1:]), cwd=work, check=True)
            merged = out("rev-parse", "HEAD", cwd=work)
            if stuck:
                # The second choice, if the protected core refuses the first: the release, with only the
                # files this Rouh added itself; every own line in a file the release has is left out.
                git("checkout", "-q", "-B", "catch-up-plain", local_release, cwd=work, check=True)
                added = [f for f in out("diff", "--name-only", "--diff-filter=A", "--no-renames", local_release, merged,
                                        cwd=work).splitlines() if f]
                if added:
                    git("checkout", "-q", merged, "--", *added, cwd=work, check=True)
                git("commit", "-q", "--allow-empty", "-m", f"Rouh {commit[:12]}, the release of {when}, with only this Rouh's own new files",
                    "-m", "The second choice of rouh-catch-up --stuck: its own lines in the release's files left out.",
                    cwd=work, check=True)
                plain = out("rev-parse", "HEAD", cwd=work)
                left_out = [f for f in out("diff", "--name-only", "--no-renames", plain, merged, cwd=work).splitlines() if f]
        local_release_commit = local_release
        name = time.strftime("%Y%m%d-%H%M%S", time.gmtime())
        git("fetch", "-q", str(work), f"+{merged}:refs/rouh/update/{name}", f"+{local_release}:refs/rouh/release/{name}",
            *([f"+{plain}:refs/rouh/update/{name}-plain"] if plain else []), cwd=CODE, check=True)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    if kept:
        say("kept as this Rouh had them, because the release changed the same lines: " + ", ".join(kept[:20]))
    if carried:
        say("the release's version, with this Rouh's own lines laid over it: " + ", ".join(carried[:20]))
    if dropped:
        say("the release's version, because this Rouh's own lines did not fit beside the release's (still in its "
            "history): " + ", ".join(dropped[:20]))
    if misfit:
        say("its own migrations left out, because beside the release's they would leave two last migrations and "
            "nothing would migrate (still in its history): " + ", ".join(misfit[:20]))
    before = point.get("n")
    say(f"handing {merged[:12]} to the protected core; its checks take a minute or a few")
    why = f"Rouh's update to Rouh {commit[:8]} of {when}, once, by rouh-catch-up" + (
        f", {own} own change{'s' if own != 1 else ''} kept" if own else "")
    answer = guard("propose", merged, why)
    if not answer.get("ok") and plain and plain != merged:
        say("the protected core refused it. What failed, the database's migration first:")
        for line in failures(answer)[:30]:
            say("  - " + line[:900])
        say(f"handing the second choice, {plain[:12]}: the release with only this Rouh's own new files")
        left = sorted(set(left_out) | set(dropped))
        answer = guard("propose", plain, why + "; its own lines in the release's files left out")
        if answer.get("ok"):
            merged, dropped, carried = plain, left, []
            say("this Rouh's own lines in these files were left out (they are in its history): " + ", ".join(left[:20]))
    if not answer.get("ok") and stuck and local_release_commit and local_release_commit not in (merged, plain):
        # The third choice: the release alone, exactly as a fresh install of it has it. Everything of this
        # Rouh's own is left out of the code that runs, and stays in its history.
        say("the protected core refused that too. What failed, the database's migration first:")
        for line in failures(answer)[:30]:
            say("  - " + line[:900])
        say(f"handing the third choice, {local_release_commit[:12]}: the release alone, as a fresh install has it")
        answer = guard("propose", local_release_commit, why + "; the release alone, its own changes left out")
        if answer.get("ok"):
            merged, carried, dropped = local_release_commit, [], sorted(set(left_out) | set(dropped) | set(misfit))
            say("every change of this Rouh's own is left out of the code that runs (it is in its history)")
    if not answer.get("ok"):
        say("the protected core did not make it live. What failed, the database's migration first:")
        for line in failures(answer)[:30]:
            say("  - " + line[:900])
        raise Refused("the protected core did not make it live, so the code is as it was: "
                      + failures(answer)[0][:1500])
    n = (answer.get("point") or {}).get("n")
    say(f"done: undo point {n} is Rouh {commit[:12]} of {when}"
        + (" alone; this Rouh's own code changes are left out (in its history), its database, keys and name kept"
           if fresh else f" with this Rouh's {own} own change{'s' if own != 1 else ''}" if own else "")
        + f"; {', '.join(answer.get('restarts') or ['core'])} start again on it.")
    if before:
        say(f"to undo: Anatomy, Meta, Changes, Put back on undo point {before}; or rouh-guard undo {before} here.")
    print("ROUH-CATCH-UP " + json.dumps({"ok": True, "release": commit, "commit": merged, "point": n,
                                         "before": before, "own": own, "kept": kept, "carried": carried,
                                         "dropped": dropped}), flush=True)
    return 0


def main(argv: list[str]) -> int:
    if any(a not in ("--check", "--stuck", "--fresh") for a in argv):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    try:
        return catch_up("--check" in argv, "--stuck" in argv or "--fresh" in argv, fresh="--fresh" in argv)
    except Refused as exc:
        say(str(exc))
        print("ROUH-CATCH-UP " + json.dumps({"ok": False, "said": str(exc)}), flush=True)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
