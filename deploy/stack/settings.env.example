# Every setting and secret Rouh's container stack reads (deploy/stack/compose.yml): the
# settings file, stack.env on a Mac (Rouh for Mac writes it) and .env on Linux.
#
#   cp settings.env.example .env     # beside compose.yml, then fill it in
#
# Only the core container is given this file. The workers never are: what
# they need is written into compose.yml, and none of it is a secret.
# Every value below is an example or blank. Never commit a filled-in .env.

# --- The stack -------------------------------------------------------------------

# The database's password, for PostgreSQL and the core only. Required: make
# one up, long and random (for example: openssl rand -base64 33).
POSTGRES_PASSWORD=

# The port on this machine's 127.0.0.1 that the page is published on.
ROUH_PORT=8420

# The Compose project's name; volumes and networks are named after it.
ROUH_STACK_NAME=rouh

# The images are not set here: release.env beside this file names them, from a
# signed release (ROUH_BASE_IMAGE, ROUH_GUARD_IMAGE, ROUH_POSTGRES_IMAGE, each by
# digest; INSTALL-LINUX-VM.md says how). Rouh's own code is the code volume's,
# and no image changes it.

# Rouh's code is free: the first start fetches it with no account and no install code.
# "free" is here only for releases made before 8 November 2026, whose first start stopped
# without a code; rouh.land answers it for everyone. An install code from an account on
# rouh.land still works in its place, and is never needed.
ROUH_INSTALL_CODE=free

# --- Model keys --------------------------------------------------------------------
# Rouh's own conversation needs an Anthropic key, or nothing answers.
# These two are kept in the keys volume on the core's first start with them;
# from then on the volume is where they are. The key proxy adds them to the
# workers' requests, so the workers never hold them. To change one later
# without putting it in this file:
#   docker compose exec -T core rouh-keys set anthropic < key.txt
ANTHROPIC_API_KEY=
# For Luna (OpenAI's model), Synapse's other answers, and runs of Codex the
# person asks to have billed to the API.
OPENAI_API_KEY=

# --- Other services' keys, the core's alone ---------------------------------------------
# Each is optional: what needs one says it is not set up, and nothing else changes.
# The voice (speech to text and text to speech).
ELEVENLABS_API_KEY=
# The voice Rouh speaks in, an ElevenLabs voice id.
ROUH_VOICE_ID=
# Synapse's vectors (search by meaning).
VOYAGE_API_KEY=
# YouTube search (the Data API v3).
YOUTUBE_API_KEY=
# LinkedIn look-ups, through Apify.
APIFY_API_TOKEN=

# --- Telegram and Rouh's own letters ---------------------------------------------------
# Rouh's bot, which writes to the owner's phone and which the owner can write to. Make one with
# Telegram's @BotFather (it gives the token), send it one message, and put your own chat's id
# here (https://api.telegram.org/bot<token>/getUpdates shows it as "chat":{"id":...}). The one
# program's questions to the phone go through this same bot: the workers never hold its token.
ROUH_TELEGRAM_BOT_TOKEN=
ROUH_TELEGRAM_CHAT_ID=
# Brevo's key (https://app.brevo.com/settings/keys/api), for the letters Rouh sends itself: a
# page shared by email, a password reset. ROUH_MAIL_FROM below is the address they come from.
ROUH_BREVO_API_KEY=

# --- The meeting library (rouh/synapse/sources/meetings.py) ---------------------------------
# The address and key of a meeting library, if this Rouh reads one; blank for none.
MEETING_LIBRARY_URL=
MEETING_LIBRARY_KEY=
MEETING_LIBRARY_WEBHOOK_SECRET=

# --- The phone address (rouh/relay.py) ---------------------------------------------------
# A Rouh born Connected asks the relay for <its name>.<the relay's domain> at birth, and the
# address is on from that moment (step 176-14); its owner can turn it off in Settings,
# Connections, Phone. Leave these blank for rouh.land's relay; set them for a relay of your own
# (on a Linux server: rouh relay URL --domain DOMAIN; INSTALL-LINUX.md, "A relay of your own").
# ROUH_RELAY=0 turns it off.
ROUH_RELAY=
ROUH_RELAY_URL=
ROUH_RELAY_DOMAIN=
# The certificate service (Let's Encrypt's own when blank).
ROUH_ACME_DIRECTORY=

# --- Your own domain, on a Linux server (rouh domain; deploy/stack/compose.yml, edge) ------
# Set by rouh domain NAME, never by hand: the stack's edge part (Caddy) then listens on ports 80
# and 443 for this name, with a certificate from Let's Encrypt, and the core answers to it. Blank:
# nothing of Rouh's listens beyond this machine. rouh domain --off clears it.
ROUH_DOMAIN=
# Another certificate service for the edge part (Let's Encrypt's staging, for a test).
ROUH_EDGE_ACME_CA=

# --- The setup code (rouh/web/firstrun.py) ------------------------------------------------
# How many hours a setup code lasts while this Rouh has no owner; the Linux installer sets 24,
# and rouh setup writes a new one. Blank or 0: until it is used (Rouh for Mac).
ROUH_SETUP_CODE_HOURS=

# --- The installation's own values (SETUP.md, deploy/installation.env.example) -------------

# The address the page is opened at; every link Rouh writes starts with it. Reached through
# a tunnel (a Cloudflare tunnel to 127.0.0.1:8420), put the tunnel's address here,
# https://<its name>: Rouh trusts forms posted from exactly that address, and from no other
# outside one, so without it every form there, the first run's included, is refused.
# Rouh for Mac writes it from its Settings window, "Your own address for Rouh".
ROUH_PUBLIC_URL=http://127.0.0.1:8420
# Every name Rouh answers to from outside, comma separated; blank for the public URL's own.
# A second name besides the public URL's own, such as a second tunnel: Rouh trusts forms
# posted from https://<that name> too.
ROUH_PUBLIC_HOSTS=
# Origins besides the public URL that the page may post from, comma separated.
ROUH_CSRF_TRUSTED_ORIGINS=
# The time zone a new person starts on, the owner included.
ROUH_DEFAULT_ZONE=UTC
# The address Rouh's letters come from; blank sends no letters.
ROUH_MAIL_FROM=
ROUH_MAIL_FROM_NAME=Rouh
# Rouh's own mailbox, if it has one; never the owner's own address.
ROUH_OWN_MAILBOXES=
# The languages the owner speaks to Rouh in, as transcriber language codes.
ROUH_STT_LANGUAGE=eng
ROUH_STT_SECONDARY=
# Whether Rouh speaks its answers out loud when a browser first opens it (1 or 0).
ROUH_VOICE_REPLIES=1

# --- The workspace's own repository (rouh/workspace_follow.py) ----------------------------
# A private repository to keep the workspace in as well, kept level both ways: new work here is
# pushed there, and new work there (from a laptop, say) comes here. An https address with a token
# that may push to it (on GitHub, a fine-grained token with Contents: read and write on that one
# repository). Blank keeps the workspace in the stack only.
ROUH_WORKSPACE_REMOTE=
ROUH_WORKSPACE_REMOTE_TOKEN=

# --- The machine ----------------------------------------------------------------------
# The UPS the machine is on, if NUT watches it there: the orb shows when it runs on battery. The
# machine itself is host.docker.internal from inside; NUT's upsd must listen where the stack can
# reach it (LISTEN 0.0.0.0 3493 in upsd.conf). Blank for none.
ROUH_UPS=

# --- The workers --------------------------------------------------------------------

# How many runs of Claude Code or Codex work at once; more wait, saying why.
# About 1.7 GB of memory each while working, and about 300 MB for each run left
# open at its prompt, on top of about 2 GB for the rest of the stack (98-06):
# 2 with a worker of 6g suits a machine of 8 GB, 4 with 10g one of 12 GB.
ONE_MAX_RUNS=2
# The most memory the worker and every run in it may hold together, such as 6g.
# Past 85% of it no run starts and the one left unwatched longest is closed.
ROUH_WORKER_MEMORY=6g
# The most memory one run may hold, such as 4G; a run over it is ended, with
# everything it started, and says why. 0 is no limit but the worker's.
ONE_RUN_MEMORY_MAX=4G
# How hard a run thinks.
ONE_EFFORT=xhigh
# The ports the key proxy lets the workers reach on the internet.
ROUH_KEYPROXY_PORTS=80,443
# Your own servers a run may reach besides, host:port, comma separated, such as
# sites.example.com:22 for a run that works on your websites over ssh. Nothing else is reached.
# Give each purpose its own key, for a user on that server that can do only that job:
#   docker compose exec worker rouh-ssh-key sites    (prints the public key to put there)
ROUH_KEYPROXY_ALLOW=

# --- Backups ------------------------------------------------------------------------
# Every night the backup part copies the database into the stack's backups volume, with
# PostgreSQL's own pg_dump, and keeps the newest ROUH_BACKUP_KEEP. At ROUH_BACKUP_AT, UTC, or
# the first minute after it that this machine is awake. Rouh says when the newest was made
# (ask it how the server is). To put one back: linux_stack.py restore (INSTALL-LINUX-VM.md).
ROUH_BACKUP_AT=03:40
ROUH_BACKUP_KEEP=7
# Once a week the core sends the newest of them off this machine, with both keys, the data and
# the workspace, as one file encrypted in age's format (rouh/offsite.py), to Cloudflare R2 or
# any S3. Blank, nothing is sent. The bucket, and an API token for it that may read and write
# objects (R2: Manage R2 API Tokens, Object Read & Write, this bucket only):
ROUH_OFFSITE_ENDPOINT=
ROUH_OFFSITE_BUCKET=
ROUH_OFFSITE_KEY_ID=
ROUH_OFFSITE_SECRET=
# What it is encrypted for, one of the two. Best, a public key whose private half is kept off
# this machine, so nothing here can open the copies: on your own computer, with age
# (age-encryption.org; brew install age), `age-keygen -o rouh-offsite.key`, and the line it
# prints, age1..., goes here. Keep rouh-offsite.key safe and away from this machine: without it
# no copy opens.
ROUH_OFFSITE_RECIPIENT=
# Or a long passphrase (openssl rand -base64 33), with a copy of it kept off this machine.
ROUH_OFFSITE_PASSPHRASE=
