# An installation's own settings, for Rouh and the one program (SETUP.md).
#
# Copy this into the installation's own environment file (or a systemd
# drop-in for rouh.service and one.service) and change every value.
# Every value here is an example: none of them is anybody's real address.
# Keys and passwords are not here; each goes where its own section of
# README.md says, and never into the repository.

# The address this installation is opened at; every link Rouh writes starts with it.
ROUH_PUBLIC_URL=https://rouh.example.com

# Every name Rouh answers to from outside, comma separated; blank is the public URL's own name alone.
ROUH_PUBLIC_HOSTS=rouh.example.com

# The address Rouh's letters are sent from, of the installation's own domain; blank sends no letters.
ROUH_MAIL_FROM=noreply@example.com

# The name the letters are sent under.
ROUH_MAIL_FROM_NAME=Rouh

# Rouh's own mailbox and any other name of it, comma separated, the first the one it writes from; never the owner's own address. Blank: Rouh has no mailbox of its own.
ROUH_OWN_MAILBOXES=rouh@example.com

# The time zone a new person starts on, until their own pages or shared location say otherwise.
ROUH_DEFAULT_ZONE=Europe/Lisbon

# The language the owner mostly speaks to Rouh in, as a transcriber language code.
ROUH_STT_LANGUAGE=eng

# Any other languages the owner speaks to it in, comma separated; blank for none.
ROUH_STT_SECONDARY=

# Words the transcriber should know (up to 50, comma separated). This replaces the product's own list in rouh/config.py, so start from that list and add the owner's: their name, their company, their domains, their city.
ROUH_STT_KEYTERMS=Rouh,nginx,Cloudflare,Anthropic,ElevenLabs,Claude Code,Alex Morgan,Example Co,example.com

# Where Rouh keeps its data on this machine.
ROUH_DATA_DIR=/var/www/rouh/data

# The file holding the Telegram bot's settings, outside the repository; read only by the service.
ROUH_TELEGRAM_FILE=/var/www/rouh/.secrets/rouh_telegram.json

# The file holding the Brevo key letters are sent with, outside the repository.
ROUH_BREVO_FILE=/var/www/rouh/.secrets/brevo.json

# The address a phone opens the one program at, for the links in its messages.
ONE_PUBLIC_URL=https://rouh.example.com/one

# Every name the one program is opened under from outside, comma separated; blank allows only ONE_PUBLIC_URL's own name.
ONE_PUBLIC_HOSTS=rouh.example.com

# --- Where Rouh lives, for running it straight on a Linux machine (deploy/) ---
#
# Read by deploy/run-server.sh, deploy/rouh.sh, deploy/with-rouh-env.sh,
# deploy/install_offsite_backup.sh, update-all.sh, land.sh and
# one/deploy/update.sh, each from its own environment: the services' own
# settings for a deploy Rouh starts, the shell's for one run by hand. The value
# shown is each one's default, so an installation in these places sets none of
# them. Each may also be given by its old name, with JARVIS_ in place of ROUH_.

# Rouh's own checkout: what the service runs and what a deploy moves.
ROUH_APP_DIR=/var/www/rouh/app

# The Python environment Rouh runs with.
ROUH_VENV=/var/www/rouh/.venv

# The settings file the service reads; a deploy's database step reads it too.
ROUH_ENV_FILE=/var/www/rouh/.env

# The name of Rouh's systemd service, which a deploy restarts.
ROUH_SERVICE=rouh

# The address and port Rouh listens on, behind the web server.
ROUH_HOST=127.0.0.1
ROUH_PORT=8021

# Rouh's health page, which a deploy waits on before it calls the new code good.
ROUH_HEALTH_URL=http://127.0.0.1:8021/healthz

# The log every deploy writes into, both services' lines in one place.
ROUH_UPDATE_LOG=/var/www/rouh/logs/update.log

# The one line a deploy leaves for Rouh to read when it comes back up; blank is self-update-outcome in ROUH_DATA_DIR.
ROUH_UPDATE_OUTCOME=

# The shared folder for land.sh's lock, its records and the deploy lock; every user that lands work must be able to write to it.
ROUH_LAND_DIR=/srv/rouh-land

# The deploy lock; blank is deploy.lock in ROUH_LAND_DIR.
ROUH_DEPLOY_LOCK=

# The person's workspace, when it is a repository of its own beside the code: Rouh serves it, and land.sh moves it onto what it lands. Unset, Rouh uses the workspace inside its own checkout, while land.sh still assumes the value shown.
ROUH_WORKSPACE=/var/www/rouh/workspace

# The one program's own checkout, Python environment, systemd service and health page.
ONE_APP_DIR=/srv/one/app
ONE_VENV=/srv/one/venv
ONE_SERVICE=one.service
ONE_HEALTH_URL=http://127.0.0.1:8031/one/healthz

# The weekly backup to R2 (deploy/backup_offsite.py): its R2 settings file, its gpg passphrase, the folder of nightly database dumps it sends, and its own working folder. install_offsite_backup.sh writes whichever of these is set into the backup's service.
ROUH_BACKUP_KEYS=/etc/rouh/r2-backup.json
ROUH_BACKUP_PASSPHRASE=/etc/rouh/backup-passphrase
ROUH_BACKUP_DUMPS=/var/backups/postgresql/18-main
ROUH_BACKUP_WORK=/var/backups/rouh-offsite
