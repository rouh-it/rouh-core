#!/usr/bin/env python3
"""rouh-guard-run WHO -- COMMAND...: runs a container's program, and starts it again when the
protected core says so.

Part of the protected core (guard/README.md). The guard cannot restart a container (no container
has the Docker socket), so the core's and the worker's start scripts run their program under this.
It reads the guard's signal (ROUH_GUARD_SIGNAL/state.json) every few seconds; when the number for
WHO ("core" or "worker") moves - the change step put a new undo point in place, an undo or the
doctor put an old one back - it stops the program and exits, and Docker's own restart policy
starts the container again on the code that now runs. A stop from Docker is passed on.

The worker is the exception: its program is started again in place, here, and the container
stays up. Every run in the worker is a Claude Code held by a holder process of its own session
(one/holder.py), which outlives the program and is adopted by the next one; a container restart
took every one of them with it, so each deploy killed every run, and on 3 November 2026 three
deploys inside four minutes left four of them lost. The worker's start script has nothing to do
again: its folders, workspace and pairings are made once and kept in its volumes.

Before either is stopped for other code, the answers Rouh is giving are let finish
(rouh_guard/deploywait.py; Petar, 3 November 2026: no restart may cut a chat answer). The core asks
Rouh, which holds new turns back after a short grace period and says when the last answer is over;
the worker only watches the same count, which the core keeps beside the runs, since a run may not
ask the core to hold anything. Ten minutes at most, and then it goes anyway, saying what it cut.

    rouh-guard-run core --step [--since N] -- python manage.py migrate --noinput

runs one step of a start the same way: the core's migrations. When the number moves while the step
runs - the doctor put other code back because this step took too long - the step is stopped and
this exits 75, so the start script ends and Docker starts the container again on the code that now
runs. No answer can be in progress while a start is still migrating, so nothing is waited for.
``--since`` is the number the start saw when it asked ``verify``. On 11 November 2026 the migration
of undo point 174 ran for fourteen minutes and nothing watched it: the doctor put 173 back, then 172,
and the core went on migrating for 174 until somebody restarted it by hand.
"""
from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

STATE = Path(os.environ.get("ROUH_GUARD_SIGNAL", "/run/guard-signal")) / "state.json"


def wait_for_answers(who: str, stopped) -> None:
    """Until Rouh is answering nothing (deploywait.py), or the most a deploy may wait."""
    if who == "core":
        folder, ask = Path(os.environ.get("ROUH_DATA_DIR", "/data/rouh")) / "deploy-wait", True
    else:
        key = os.environ.get("ROUH_WORKER_KEY_FILE", "/run/one/rouh-worker.json")
        folder, ask = Path(key).parent / "deploy-wait", False
    try:
        from rouh_guard import deploywait

        deploywait.wait(folder, who, why="the protected core put other code in place", ask=ask,
                        stopped=stopped)
    except Exception as exc:  # noqa: BLE001 - a deploy is never stopped by the wait
        print(f"{who}: could not wait for Rouh's answers ({type(exc).__name__}: {exc}); going on", flush=True)


def number(who: str):
    try:
        return json.loads(STATE.read_text())["restart"].get(who)
    except (OSError, ValueError, KeyError, AttributeError):
        return None


def main(argv: list[str]) -> int:
    if "--" not in argv or argv.index("--") < 1 or argv.index("--") == len(argv) - 1:
        print("usage: rouh-guard-run core|worker [--step [--since N]] -- command ...", file=sys.stderr)
        return 2
    cut = argv.index("--")
    who, opts, cmd = argv[0], argv[1:cut], argv[cut + 1:]
    step = "--step" in opts
    start = number(who)
    if "--since" in opts:
        try:
            start = int(opts[opts.index("--since") + 1])
        except (IndexError, ValueError):
            pass
    child = subprocess.Popen(cmd, start_new_session=True)
    stopping = {"why": ""}
    # Started again in place rather than by restarting the container (see above).
    in_place = who == "worker"

    def stop(why: str) -> None:
        stopping["why"] = why
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        end = time.monotonic() + 30
        while child.poll() is None and time.monotonic() < end:
            time.sleep(0.5)
        if child.poll() is None:
            os.killpg(child.pid, signal.SIGKILL)

    signal.signal(signal.SIGTERM, lambda *_: stop("asked to stop"))
    signal.signal(signal.SIGINT, lambda *_: stop("asked to stop"))
    while child.poll() is None:
        time.sleep(3)
        now = number(who)
        if now is not None and start is not None and now != start:
            print(f"{who}: the protected core put other code in place; starting again on it", flush=True)
            if step:
                stop("restart")
                return 75
            wait_for_answers(who, lambda: bool(stopping["why"]) or child.poll() is not None)
            if stopping["why"]:
                break
            # Another change may have gone live while it waited: this start is onto the newest.
            now = number(who) if number(who) is not None else now
            stop("restart")
            if in_place and stopping["why"] == "restart":
                # Only the program's own process group is stopped; the runs' holders, each in a
                # session of its own, carry on and are adopted by the program started here.
                start, stopping["why"] = now, ""
                child = subprocess.Popen(cmd, start_new_session=True)
                continue
            break
        if start is None:
            start = now
    code = child.wait()
    if step:
        # A step stopped by Docker must not let the start go on to the server.
        return 143 if stopping["why"] else code
    return 0 if stopping["why"] else code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
