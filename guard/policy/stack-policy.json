{
  "about": "What a Rouh's own stack file may ask for: the allow-list the stack check holds every resolved setting to (guard/rouh_guard/stackpolicy.py, and Rouh for Mac's StackPolicy.swift, which read this same file). Anything not listed here is refused. Signed into each release, beside the reference stack file. Task 98, step 98-23.",
  "format": 1,
  "top_level": ["name", "services", "networks", "volumes"],
  "service_keys": ["image", "build", "command", "entrypoint", "environment", "depends_on", "healthcheck",
                   "restart", "user", "init", "working_dir", "labels", "networks", "volumes", "tmpfs", "ports",
                   "expose", "cap_drop", "cap_add", "security_opt", "read_only", "shm_size", "logging",
                   "stop_grace_period", "stop_signal", "hostname", "mem_limit", "mem_reservation", "cpus",
                   "pids_limit", "ulimits", "network_mode", "platform", "pull_policy", "extra_hosts"],
  "build_keys": ["context", "dockerfile", "args", "target", "labels"],
  "network_keys": ["name", "internal", "driver", "ipam", "labels", "enable_ipv6"],
  "volume_keys": ["name", "driver", "labels"],
  "network_modes": ["none"],
  "network_drivers": ["bridge"],
  "volume_drivers": ["local"],
  "logging_drivers": ["local", "json-file", "none"],
  "volume_types": ["volume", "tmpfs"],
  "restart": ["no", "always", "unless-stopped", "on-failure"],
  "cap_add": ["CHOWN", "DAC_OVERRIDE", "FOWNER", "SETUID", "SETGID", "DAC_READ_SEARCH"],
  "security_opt": ["no-new-privileges:true", "no-new-privileges"],
  "published_host_ips": ["127.0.0.1"],
  "refused_words": ["include", "extends", "label_file"],
  "protected_services": ["guard-init", "guard", "keyproxy", "code-install", "checkdb", "worker-perms"],
  "required_services": ["guard-init", "guard", "keyproxy", "code-install", "checkdb", "worker-perms", "core", "worker"],
  "pinned": {
    "core": ["entrypoint", "user", "init", "cap_drop", "security_opt", "read_only"],
    "worker": ["entrypoint", "user", "init", "cap_drop", "security_opt", "read_only"],
    "browser": ["entrypoint", "user", "init", "cap_drop", "cap_add", "security_opt", "read_only",
                "networks", "volumes", "environment"]
  },
  "base_image_services": ["core", "worker", "browser"],
  "protected_networks": ["db", "workers", "guard-check", "egress", "edge", "browser"],
  "network_only": {
    "egress": ["keyproxy"],
    "edge": ["core"],
    "browser": ["core", "keyproxy", "browser"],
    "guard-check": ["guard", "checkdb"]
  },
  "protected_volumes": {
    "keys": {"core": "rw", "keyproxy": "ro"},
    "code": {"core": "rw", "guard": "rw", "code-install": "rw", "worker": "ro"},
    "guard-bin": {"guard-init": "rw", "guard": "ro", "core": "ro", "worker": "ro", "code-install": "ro",
                  "browser": "ro", "backup": "ro"},
    "guard-state": {"guard": "rw"},
    "guard-run": {"guard": "rw", "core": "ro"},
    "guard-signal": {"guard": "rw", "core": "ro", "worker": "ro"}
  }
}
